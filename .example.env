# Copy this file to .env and fill in the values.

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kyoto_anime?retryWrites=true&w=majority

# --- Server ---
PORT=5001
NODE_ENV=development

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
COOKIE_DOMAIN=

# --- CORS / Frontend ---
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173

# --- Anime data source (AniList) ---
ANILIST_API_URL=https://graphql.anilist.co

# --- Optional: YouTube Data API key for trailer resolution ---
YOUTUBE_API_KEY=

# --- Optional: seed an administrator account on boot ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Optional: Google Gemini API key for AI recommendations ---
GEMINI_API_KEY=
